# wolf-systems provider-neutral SMTP configuration
# NEVER commit real secrets.

# Preferred zero-cost architecture:
#   inbound:  Cloudflare Email Routing
#   outbound: Brevo SMTP
WOLF_SMTP_PROVIDER=brevo
WOLF_SMTP_HOST=smtp-relay.brevo.com
WOLF_SMTP_PORT=587
WOLF_SMTP_SECURITY=starttls

# Brevo credentials.
# Login is non-secret and may be stored in config; key MUST stay secret.
BREVO_SMTP_LOGIN=b6a71e001@smtp-brevo.com
BREVO_SMTP_KEY=replace-locally

# Authenticated outbound identities.
# outreach.wolf-systems.online is the Brevo-authenticated sending domain.
WOLF_EMAIL_PARTNER=partner@outreach.wolf-systems.online
WOLF_EMAIL_ANDREAS=andreas@outreach.wolf-systems.online
WOLF_EMAIL_KONTAKT=kontakt@outreach.wolf-systems.online

# During migration, replies can still be directed to the existing root-domain
# Private Email addresses with --reply-to, e.g. andreas@wolf-systems.online.

# Optional generic relay fallback:
# WOLF_SMTP_PROVIDER=generic
# WOLF_SMTP_HOST=smtp.example.com
# WOLF_SMTP_PORT=587
# WOLF_SMTP_SECURITY=starttls
# WOLF_SMTP_USERNAME=replace-locally
# WOLF_SMTP_PASSWORD=replace-locally

# Legacy Namecheap Private Email fallback remains supported:
# WOLF_SMTP_PROVIDER=privateemail
# WOLF_SMTP_HOST=mail.privateemail.com
# WOLF_SMTP_PORT=465
# WOLF_SMTP_SECURITY=ssl
# WOLF_EMAIL_PARTNER_PASSWORD=replace-locally
# WOLF_EMAIL_ANDREAS_PASSWORD=replace-locally
# WOLF_EMAIL_KONTAKT_PASSWORD=replace-locally
