# wolf-systems / Namecheap Private Email
# Copy to a local, untracked environment file or export these variables.
# NEVER commit real credentials.

# Mailbox roles
WOLF_EMAIL_PARTNER=partner@wolf-systems.online
WOLF_EMAIL_PARTNER_PASSWORD=replace-locally

WOLF_EMAIL_ANDREAS=andreas@wolf-systems.online
WOLF_EMAIL_ANDREAS_PASSWORD=replace-locally

WOLF_EMAIL_KONTAKT=kontakt@wolf-systems.online
WOLF_EMAIL_KONTAKT_PASSWORD=replace-locally

# SMTP: implicit TLS on 465 by default.
# Alternative: port 587 with PRIVATEEMAIL_SMTP_SECURITY=starttls
PRIVATEEMAIL_SMTP_HOST=mail.privateemail.com
PRIVATEEMAIL_SMTP_PORT=465
PRIVATEEMAIL_SMTP_SECURITY=ssl

PRIVATEEMAIL_IMAP_HOST=mail.privateemail.com
PRIVATEEMAIL_IMAP_PORT=993
