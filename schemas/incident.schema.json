{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ager.dev/schemas/incident.schema.json",
  "title": "AGER Incident / Near-Miss Record",
  "description": "Operational incident and near-miss record for AI agents.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ager_version", "incident_id", "record_id", "kind", "status", "detected_at", "summary"],
  "properties": {
    "ager_version": {"const": "0.1"},
    "incident_id": {"type": "string", "minLength": 1},
    "record_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string"},
    "kind": {"enum": ["near_miss", "incident"]},
    "status": {"enum": ["open", "contained", "resolved", "closed"]},
    "severity": {"enum": ["informational", "low", "medium", "high", "critical", "unknown"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "detected_at": {"type": "string", "format": "date-time"},
    "contained_at": {"type": "string", "format": "date-time"},
    "resolved_at": {"type": "string", "format": "date-time"},
    "summary": {"type": "string", "minLength": 1},
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "financial": {"type": "string"},
        "data": {"type": "string"},
        "communications": {"type": "string"},
        "systems": {"type": "string"},
        "people": {"type": "string"}
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timestamp", "event"],
        "properties": {
          "timestamp": {"type": "string", "format": "date-time"},
          "event": {"type": "string", "minLength": 1},
          "actor": {"type": "string"},
          "evidence_ref": {"type": "string"}
        }
      }
    },
    "tool_calls": {"type": "array", "items": {"type": "string"}},
    "permissions_at_time": {"type": "array", "items": {"type": "string"}},
    "human_approvals": {"type": "array", "items": {"type": "string"}},
    "containment_actions": {"type": "array", "items": {"type": "string"}},
    "root_cause": {"type": "string"},
    "corrective_actions": {"type": "array", "items": {"type": "string"}},
    "owasp_asi_refs": {"type": "array", "items": {"type": "string", "pattern": "^ASI[0-9]{2}$"}, "uniqueItems": true},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "safe_export_ready": {"type": "boolean", "default": false},
    "notes": {"type": "string"}
  }
}
